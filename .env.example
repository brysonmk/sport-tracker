# Copy this file to .env and adjust. .env is gitignored; never commit real secrets.

# Postgres connection string.
# Local dev: matches docker-compose.yml (run `docker compose up -d`).
# Production: your Neon pooled connection string (it ends in ?sslmode=require).
DATABASE_URL="postgresql://sports:sports@localhost:5433/sports_tracker"

# Production only (Neon): the DIRECT (non-pooled) connection string, used by Prisma
# migrations during the Vercel build. Leave unset locally.
# DIRECT_URL="postgresql://...neon.tech/neondb?sslmode=require"

# Public base URL of the app, used for absolute links: seed output and share-image
# (og:image) URLs. No trailing slash. Optional on Vercel, where the production domain
# is detected automatically.
APP_URL="http://localhost:3000"

# Optional. Turns on AI match recaps (admin "Write recap" button + recap on public match
# pages). Leave unset to hide the feature completely. Create a key at
# https://platform.claude.com (Settings > API keys) and put it in .env / Vercel, never in git.
# ANTHROPIC_API_KEY="..."
