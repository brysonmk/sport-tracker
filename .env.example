# Copy this file to .env and adjust. .env is gitignored; never commit real secrets.

# Postgres connection string.
# Local dev: matches docker-compose.yml (run `docker compose up -d`).
# Production: your Neon pooled connection string (it ends in ?sslmode=require).
DATABASE_URL="postgresql://sports:sports@localhost:5433/sports_tracker"

# Public base URL of the app, used to print and build absolute links
# (seed output now; share-image URLs later). No trailing slash.
APP_URL="http://localhost:3000"
